{
  "manifest_version": 3,
  "name": "Tab Overview",
  "version": "0.5.2",
  "description": "__MSG_description__",
  "default_locale": "en",
  "homepage_url": "https://github.com/Jeremy233/tab-overview",
  "minimum_chrome_version": "112",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "tabGroups", "storage", "favicon"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "__MSG_actionTitle__"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "__MSG_actionTitle__"
    }
  }
}
